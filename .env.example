# ── LLM Configuration ────────────────────────────────────────────────
# Option A (Paid): OpenAI
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# Option B (Paid): Anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL_NAME=claude-3-5-sonnet-20241022

# Option C (100% FREE): Google Gemini (Get key at https://aistudio.google.com)
# GEMINI_API_KEY=
# LLM_MODEL_NAME=gemini/gemini-1.5-flash

# Option D (100% FREE): Groq (Get key at https://console.groq.com)
# GROQ_API_KEY=
# LLM_MODEL_NAME=groq/llama-3.3-70b-versatile
FALLBACK_LLM_MODEL=groq/openai/gpt-oss-20b

# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Dashboard API ────────────────────────────────────────────────────
DASHBOARD_API_TOKEN=

# ── Exchange Configuration ───────────────────────────────────────────
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# ── Live Mode Gating (Phase 9) ────────────────────────────────────────
# Must be set to true to authorize live execution with real capital
LIVE_TRADING_ENABLED=false

